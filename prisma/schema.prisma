generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGEND
}

enum Element {
  PYRO
  HYDRO
  ANEMO
  ELECTRO
  DENDRO
  CRYO
  GEO
}

enum ADMIN_ROLE {
  ADMIN
  EDITOR
}

model AdminUser {
  id        Int        @id @default(autoincrement())
  userName  String     @unique
  password  String
  role      ADMIN_ROLE @default(EDITOR)
  createdAt DateTime   @default(now())
}

model Character {
  id          Int      @id @default(autoincrement())

  slug        String   @unique
  name        String
  image       String
  splashImage String?

  rarity      Rarity
  element     Element
  weaponType  String?
  region      String?
  sticker     String?

  /// Материалы прокачки: [{ id, name, image, qty, category }]
  levelMaterials Json?

  /// Таланты: [{ id, name, icon, videoUrl, description, loreText, statsTable, order }]
  talents     Json?

  /// Созвездия: [{ id, level, name, icon, description, order }]
  constellations Json?

  shortDesc   String?
  contentHtml String   @db.Text

  published   Boolean  @default(true)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Weapon {
  id          Int      @id @default(autoincrement())

  slug        String   @unique
  name        String
  image       String
  rarity      Rarity
  weaponType  String
  region      String?
  sticker     String?

  shortDesc   String?
  contentHtml String   @db.Text @default("")
  /// Структурированный гайд: материалы, фазы, кому подходит, как получить
  guideData   Json?

  published   Boolean  @default(true)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Artifact {
  id          Int      @id @default(autoincrement())

  slug        String   @unique
  name        String
  image       String
  rarity      Rarity
  region      String?
  sticker     String?

  shortDesc   String?
  contentHtml String   @db.Text @default("")

  published   Boolean  @default(true)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Material {
  id          Int      @id @default(autoincrement())

  slug        String   @unique
  name        String
  image       String
  /// 1–5 звёзд материала
  rarityStars Int      @default(4)
  category    String   @default("other")
  region      String?
  sticker     String?

  shortDesc   String?
  contentHtml String   @db.Text @default("")
  /// Структурированный гайд: описание, оружие, алхимия, источники
  guideData   Json?

  published   Boolean  @default(true)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Page {
  id          Int      @id @default(autoincrement())

  slug        String   @unique
  title       String
  contentHtml String   @db.Text
  published   Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PromoCode {
  id        Int       @id @default(autoincrement())
  code      String
  reward    String
  expiresAt DateTime?
  published Boolean   @default(true)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model DailyTip {
  id        Int      @id @default(autoincrement())
  title     String
  body      String   @db.Text
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Слайд баннера на главной (половина молитвы + персонаж)
model HomeBannerSlide {
  id        Int      @id @default(autoincrement())
  /// first = текущие молитвы, second = вторая половина
  half      String
  name      String
  slug      String
  role      String
  /// pyro | hydro | anemo | electro | dendro | cryo | geo
  element   String
  rarity    Int      @default(5)
  text      String   @db.Text
  image     String
  icon      String
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Событие аналитики: просмотры, клики, Telegram и т.д.
model AnalyticsEvent {
  id           String   @id @default(cuid())
  /// pageview | click | telegram_click | outbound
  type         String
  path         String
  title        String?
  /// character | weapon | artifact | material | home | map | other
  entityType   String?
  entitySlug   String?
  entityName   String?

  sessionId    String
  visitorId    String

  ip           String?
  country      String?
  countryCode  String?
  city         String?
  region       String?

  userAgent    String?  @db.Text
  referrer     String?
  language     String?
  screen       String?

  /// Доп. данные: placement (navbar/sidebar/footer), label и т.д.
  meta         Json?

  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([path, createdAt])
  @@index([entityType, entitySlug, createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId])
  @@index([ip, createdAt])
  @@index([countryCode, createdAt])
}

/// Публичный пользователь (счётчик молитв)
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  emailVerified DateTime?
  name         String?
  image        String?
  /// bcrypt; null если только Google
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts     Account[]
  wishAccounts WishAccount[]
}

/// OAuth-аккаунты (Google и др.)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Игровой профиль / слот истории молитв
model WishAccount {
  id        String   @id @default(cuid())
  userId    String
  /// UID из игры, если известен
  uid       String?
  label     String   @default("Основной")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pulls WishPull[]

  @@index([userId])
}

/// Одна молитва (pull)
model WishPull {
  id        String   @id @default(cuid())
  accountId String
  /// Уникальный id из API Hoyoverse / экспорта
  hoyoId    String
  /// 100 novice | 200 permanent | 301/400 character | 302 weapon
  gachaType String
  itemName  String
  /// Character | Weapon
  itemType  String
  /// 3 | 4 | 5
  rankType  String
  wishTime  DateTime
  raw       Json?

  createdAt DateTime @default(now())

  account WishAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, hoyoId])
  @@index([accountId, gachaType, wishTime])
  @@index([accountId, wishTime])
}
